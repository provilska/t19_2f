using System;

namespace konstruktory
{
    internal class Program

    {
        static void Main(string[] args)
        {
            string firstName = GetValidString("imię");
            string lastName = GetValidString("nazwisko");
            DateTime dateOfBirth = GetValidDate();
            Student me = new Student(firstName, lastName, dateOfBirth);
            Console.WriteLine($"Imię: {me.FirstName}, Nazwisko: {me.LastName}, Wiek: {me.Age}");
            Console.WriteLine(IsAdult(me));
            Console.WriteLine("Czy chcesz edytować dane? (tak/nie): ");
            string choice = Console.ReadLine().ToLower();
            if (choice == "tak")
            {
                EditingData(me);
            }
            else
            {
                Console.WriteLine("Zakończenie programu");
                return;
            }
        }

        private static void EditingData(Student me)
        {
            bool exit = false;
            while (!exit)
            {
            Console.WriteLine("Co chcesz edytować?");
            Console.WriteLine("1. Imię");
            Console.WriteLine("2. Nazwisko");
            Console.WriteLine("3. Wiek");
            Console.WriteLine("4. Zakończ program");
            string choice = Console.ReadLine();
            switch (choice)
            {
                case "1":
                    FirstNameEditing(me);
                    break;
                case "2":
                    LastNameEditing(me);
                    break;
                case "3":
                    DateOfBirthEditing(me);
                    break;
                case "4":
                    exit = true;
                    break;
                default: Console.WriteLine("Wybierz poprawną opcje");
                    break;
            }
            Console.WriteLine($"Zaktualizowane dane: Imię: {me.FirstName}, Nazwisko: {me.LastName}, Wiek: {me.Age}");


            }
        }

        private static void DateOfBirthEditing(Student me)
        {
            Console.WriteLine($"Twoja bierząca data urodzenia to {me.DateOfBirth}");
            Console.Write("Podaj nową datę urodzenia (RRRR-MM-DD): ");
            DateTime newDateOfBirth = GetValidDate();
            me.DateOfBirth = newDateOfBirth;
        }

        private static void LastNameEditing(Student me)
        {
            Console.WriteLine($"Twoje birzące nazwisko to {me.LastName}");
            Console.Write("Podaj nowe nazwisko: ");
            string newLastName = GetValidString("nazwisko");
            me.LastName = newLastName;
        }

        private static void FirstNameEditing(Student me)
        {
            Console.WriteLine($"Twoje birzące imię to {me.FirstName}");
            Console.Write("Podaj nowe imię: ");
            string newFirstName = GetValidString("imię");
            me.FirstName = newFirstName;

        }

        private static string IsAdult(Student me)
        { 
            int age = me.Age;
            if (age >= 18)
            {
                return "Student jest pełnoletni";
            }
            else
            {
                return "Student nie jest pełnoletni";
            }
        }
        class Student
        {
            public string FirstName { get; set; }
            public string LastName { get; set; }
            public DateTime DateOfBirth { get; set; }
            public int Age => CalculateAge();
            public Student(string firstName, string lastName, DateTime dateOfBirth)
            {
                FirstName = firstName;
                LastName = lastName;
                DateOfBirth = dateOfBirth;
            }
            private int CalculateAge()
            {
                var today = DateTime.Today;
                int age = today.Year - DateOfBirth.Year;
                if (DateOfBirth.Date > today.AddYears(-age))
                    age--;
                return age;
            }
            

           
            
        }
       
        const byte minLength = 2;
        const byte maxLength = 30;
        private static string GetValidString(string name)
        {
            string value;
            
            string[] errorMessage = new string[]
            {
                    "Imie nie może byc puste",
                    $"Imię musi mieć conajmniej {minLength} znaków",
                    $"Imię nie może mieć powyżej {maxLength} znaków"
            };
            do
            {
                Console.Write($"Podaj {name}: ");
                value = Console.ReadLine()?.Trim();
                Console.ForegroundColor = ConsoleColor.Red;
                if (string.IsNullOrWhiteSpace(value))
                {
                    Console.WriteLine(errorMessage[0]);
                }
                else if (value.Length < minLength)
                {
                    Console.WriteLine(errorMessage[1]);

                }
                else if (value.Length > maxLength)
                {
                    Console.WriteLine(errorMessage[2]);
                }
                Console.ResetColor();
            }
            while (string.IsNullOrWhiteSpace(value) || value.Length < minLength || value.Length > maxLength);
            return value;
        }

        private static DateTime GetValidDate()
        {
            DateTime dateOfBirth;
            bool isValid = false;
            do
            {
                Console.Write("Podaj datę urodzenia (YYYY-MM-DD): ");
                string input = Console.ReadLine();
                if (DateTime.TryParse(input, out dateOfBirth) && dateOfBirth <= DateTime.Now)
                {
                    isValid = true;
                }
                else
                {
                    Console.WriteLine("Podaj poprawną datę urodzenia!");
                }
            }
            while (!isValid);
            return dateOfBirth;
        }

        

    }
}
