using System;
using System.Collections.Generic;

namespace SofiaProvilska
{
    internal class Program
    {
        static void Main(string[] args)
        {
            // Słowniki do przechowywania graczy i drużyn
            Dictionary<string, List<string>> players = new Dictionary<string, List<string>>(); // Nazwisko -> Lista danych gracza
            Dictionary<string, List<string>> teams = new Dictionary<string, List<string>>(); // Nazwa drużyny -> Lista nazwisk graczy
            Dictionary<string, int> teamWins = new Dictionary<string, int>(); // Nazwa drużyny -> Liczba wygranych meczów
            List<string> matchHistory = new List<string>(); // Historia meczów

            bool exit = true;
            while (exit)
            {
                DisplayMenu();
                string choice = Console.ReadLine();
                switch (choice)
                {
                    case "1":
                        // Dodawanie nowego gracza
                        Console.WriteLine("Podaj imię nowego gracza:");
                        string firstName = Console.ReadLine();
                        Console.WriteLine("Podaj nazwisko gracza: ");
                        string lastName = Console.ReadLine();
                        Console.WriteLine("Podaj wiek gracza: ");
                        int age = int.Parse(Console.ReadLine());
                        Console.WriteLine("Podaj drużyne gracza: ");
                        string team = Console.ReadLine();
                        Console.WriteLine("Podaj gatunek gry gracza: ");
                        string gameGenre = Console.ReadLine();
                        Console.WriteLine("Podaj liczbę punktów rankingowych gracza: ");
                        int score = int.Parse(Console.ReadLine());

                        // Zapisz dane gracza do słownika
                        players[lastName] = new List<string> { firstName, lastName, age.ToString(), team, gameGenre, score.ToString() };
                        Console.WriteLine("Dane zostały dodane");
                        break;

                    case "2":
                        // Ranking drużyn na podstawie punktów rankingowych graczy
                        Dictionary<string, int> teamScores = new Dictionary<string, int>();

                        foreach (var player in players.Values)
                        {
                            string playerTeam = player[3];
                            int playerScore = int.Parse(player[5]);

                            if (teamScores.ContainsKey(playerTeam))
                            {
                                teamScores[playerTeam] += playerScore;
                            }
                            else
                            {
                                teamScores[playerTeam] = playerScore;
                            }
                        }

                        Console.WriteLine("Ranking drużyn na podstawie punktów:");
                        foreach (var teamScore in teamScores)
                        {
                            Console.WriteLine($"Drużyna: {teamScore.Key}, Punkty: {teamScore.Value}");
                        }
                        break;

                    case "3":
                        // Tworzenie nowej drużyny
                        Console.WriteLine("Podaj nazwę drużyny: ");
                        string teamName = Console.ReadLine();
                        Console.WriteLine("Podaj liczbę graczy drużyny: ");
                        int teamPlayerCount = int.Parse(Console.ReadLine());

                        List<string> teamPlayers = new List<string>();
                        for (int i = 0; i < teamPlayerCount; i++)
                        {
                            Console.WriteLine($"Podaj nazwisko gracza {i + 1}: ");
                            string playerLastName = Console.ReadLine();

                            if (players.ContainsKey(playerLastName))
                            {
                                teamPlayers.Add(playerLastName);
                            }
                            else
                            {
                                Console.WriteLine("Gracz o tym nazwisku nie istnieje.");
                            }
                        }

                        teams[teamName] = teamPlayers;
                        teamWins[teamName] = 0; // Inicjalizujemy liczbę wygranych meczów drużyny
                        Console.WriteLine("Drużyna została utworzona.");
                        break;

                    case "4":
                        // Przypisywanie gracza do drużyny
                        Console.WriteLine("Podaj nazwisko gracza do przypisania do drużyny: ");
                        string playerName = Console.ReadLine();
                        Console.WriteLine("Podaj nazwę drużyny: ");
                        string assignedTeam = Console.ReadLine();

                        if (players.ContainsKey(playerName) && teams.ContainsKey(assignedTeam))
                        {
                            teams[assignedTeam].Add(playerName);
                            Console.WriteLine("Gracz został przypisany do drużyny.");
                        }
                        else
                        {
                            Console.WriteLine("Błąd: Gracz lub drużyna nie istnieje.");
                        }
                        break;

                    case "5":
                        // Usuwanie gracza z drużyny
                        Console.WriteLine("Podaj nazwisko gracza do usunięcia: ");
                        string playerToRemove = Console.ReadLine();
                        Console.WriteLine("Podaj nazwę drużyny: ");
                        string teamToRemoveFrom = Console.ReadLine();

                        if (teams.ContainsKey(teamToRemoveFrom) && teams[teamToRemoveFrom].Contains(playerToRemove))
                        {
                            teams[teamToRemoveFrom].Remove(playerToRemove);
                            Console.WriteLine("Gracz został usunięty z drużyny.");
                        }
                        else
                        {
                            Console.WriteLine("Gracz nie należy do tej drużyny.");
                        }
                        break;

                    case "6":
                        // Rozwiązanie drużyny
                        Console.WriteLine("Podaj nazwę drużyny do rozwiązania: ");
                        string teamToDelete = Console.ReadLine();

                        if (teams.ContainsKey(teamToDelete))
                        {
                            teams.Remove(teamToDelete);
                            Console.WriteLine("Drużyna została rozwiązana.");
                        }
                        else
                        {
                            Console.WriteLine("Drużyna o tej nazwie nie istnieje.");
                        }
                        break;

                    case "7":
                        // Edycja danych gracza
                        Console.WriteLine("Podaj nazwisko gracza, którego chcesz edytować: ");
                        string playerToEdit = Console.ReadLine();

                        if (players.ContainsKey(playerToEdit))
                        {
                            Console.WriteLine("Podaj nowe imię gracza: ");
                            players[playerToEdit][0] = Console.ReadLine();
                            Console.WriteLine("Podaj nowe nazwisko gracza: ");
                            players[playerToEdit][1] = Console.ReadLine();
                            Console.WriteLine("Podaj nowy wiek gracza: ");
                            players[playerToEdit][2] = Console.ReadLine();
                            Console.WriteLine("Podaj nowy gatunek gry gracza: ");
                            players[playerToEdit][4] = Console.ReadLine();
                            Console.WriteLine("Podaj nową liczbę punktów rankingowych gracza: ");
                            players[playerToEdit][5] = Console.ReadLine();

                            Console.WriteLine("Dane zostały zaktualizowane.");
                        }
                        else
                        {
                            Console.WriteLine("Gracz o tym nazwisku nie istnieje.");
                        }
                        break;

                    case "8":
                        // Przeglądanie graczy według gatunku gry
                        Console.WriteLine("Podaj gatunek gry: ");
                        string genre = Console.ReadLine();

                        Console.WriteLine($"Gracze w gatunku {genre}:");
                        foreach (var player in players)
                        {
                            if (player.Value[4].ToLower() == genre.ToLower())
                            {
                                Console.WriteLine($"{player.Value[0]} {player.Value[1]}");
                            }
                        }
                        break;

                    case "9":
                        // Przeglądanie drużyn i ich składu
                        Console.WriteLine("Drużyny i ich skład:");
                        foreach (var teamIn in teams)
                        {
                            Console.WriteLine($"Drużyna: {teamIn.Key}");
                            Console.WriteLine("Gracze:");
                            foreach (var playerInTeam in teamIn.Value)
                            {
                                Console.WriteLine(playerInTeam);
                            }
                        }
                        break;

                    case "10":
                        // Rozgrywanie meczu
                        Console.WriteLine("Podaj nazwę pierwszej drużyny: ");
                        string team1 = Console.ReadLine();
                        Console.WriteLine("Podaj nazwę drugiej drużyny: ");
                        string team2 = Console.ReadLine();

                        if (teams.ContainsKey(team1) && teams.ContainsKey(team2))
                        {
                            Console.WriteLine("Wybierz zwycięzcę: 1 - " + team1 + ", 2 - " + team2);
                            string winner = Console.ReadLine();

                            if (winner == "1")
                            {
                                teamWins[team1]++;
                                matchHistory.Add($"{team1} wygrało z {team2}");
                            }
                            else if (winner == "2")
                            {
                                teamWins[team2]++;
                                matchHistory.Add($"{team2} wygrało z {team1}");
                            }

                            Console.WriteLine("Mecz został zakończony.");
                        }
                        else
                        {
                            Console.WriteLine("Jedna z drużyn nie istnieje.");
                        }
                        break;

                    case "11":
                        // Wyświetlanie historii meczów
                        Console.WriteLine("Historia meczów:");
                        foreach (var match in matchHistory)
                        {
                            Console.WriteLine(match);
                        }
                        break;

                    case "12":
                        // Ranking drużyn na podstawie liczby wygranych meczów
                        Console.WriteLine("Ranking drużyn na podstawie liczby wygranych meczów:");
                        foreach (var team in teamWins)
                        {
                            Console.WriteLine($"Drużyna: {team.Key}, Wygrane: {team.Value}");
                        }
                        break;

                    case "13":
                        // Wyszukiwanie gracza po nazwisku
                        Console.WriteLine("Podaj nazwisko gracza, którego chcesz wyszukać: ");
                        string searchLastName = Console.ReadLine();

                        if (players.ContainsKey(searchLastName))
                        {
                            var playerData = players[searchLastName];
                            Console.WriteLine($"Gracz znaleziony: {playerData[0]} {playerData[1]}, Wiek: {playerData[2]}, Drużyna: {playerData[3]}, Gatunek gry: {playerData[4]}, Punkty rankingowe: {playerData[5]}");
                        }
                        else
                        {
                            Console.WriteLine("Nie znaleziono gracza o tym nazwisku.");
                        }
                        break;

                    case "14":
                        exit = false;
                        break;

                    default:
                        Console.WriteLine("Wybierz poprawną opcję");
                        break;
                }
            }
        }

        static void DisplayMenu()
        {
            Console.WriteLine("1. Dodawanie nowego gracza");
            Console.WriteLine("2. Ranking drużyn ");
            Console.WriteLine("3. Tworzenie nowej drużyny");
            Console.WriteLine("4. Przypisywanie gracza do drużyny");
            Console.WriteLine("5. Usuwanie gracza z drużyny");
            Console.WriteLine("6. Rozwiązanie drużyny");
            Console.WriteLine("7. Edycja danych gracza");
            Console.WriteLine("8. Przeglądanie graczy według gatunku gry.");
            Console.WriteLine("9. Przeglądanie drużyn i ich składu.");
            Console.WriteLine("10. Rozgrywanie meczu między dwiema drużynami:");
            Console.WriteLine("11. Wyświetlanie historii meczów");
            Console.WriteLine("12. Ranking drużyn na podstawie liczby wygranych meczów.");
            Console.WriteLine("13. Wyszukiwanie gracza po nazwisku.");
            Console.WriteLine("14. Wyjście z programu");
        }
    }
}


Twoim zadaniem jest napisanie programu konsolowego w C#, który będzie zarządzał turniejem esportowym. Program powinien obsługiwać graczy, drużyny oraz rozgrywki. Należy zaimplementować
menu, które umożliwi użytkownikowi wykonywanie różnych operacji na danych.
Zadanie zostało utrudnione poprzez dodanie nowych funkcjonalności:
 Historia meczów między drużynami.
 Ranking drużyn na podstawie liczby wygranych meczów.
 Automatyczne generowanie turniejowej drabinki i symulacja wyników.
 Drużyny mogą zostać rozwiązane, a ich gracze wracają do puli wolnych zawodników.
 Możliwość edycji danych graczy (np. zmiana drużyny, wieku itp.).
Wymagania funkcjonalne:
1. Definicja enum dla gatunków gier:
o FPS, MOBA, BattleRoyale, RTS, RPG, Sportowe.
2. Struktura danych dla graczy:
o Każdy gracz ma:
 imię
 nazwisko
 wiek
 drużynę (lub informację, że nie należy do żadnej)
 gatunek gry
 liczbę punktów rankingowych
3. Struktura danych dla drużyn:
o Drużyna posiada:
 nazwę
 listę graczy
 łączną liczbę punktów rankingowych
 liczbę wygranych meczów
o Drużyna może liczyć maksymalnie 5 graczy.
4. Struktura danych dla historii meczów:
o Każdy mecz zawiera:
 Nazwy drużyn, które ze sobą rywalizowały
 Zwycięzcę meczu
 Datę meczu
Funkcjonalność programu:
1. Wyświetlanie menu z dostępnymi opcjami.
2. Dodawanie nowego gracza do systemu.
3. Tworzenie nowej drużyny.
4. Przypisywanie gracza do drużyny (jeśli drużyna nie ma jeszcze 5 członków).
5. Usuwanie gracza z drużyny.
6. Rozwiązanie drużyny (wszyscy gracze wracają do puli wolnych zawodników).
7. Edycja danych gracza (zmiana drużyny, wieku, punktów rankingowych).
8. Przeglądanie graczy według gatunku gry.
9. Przeglądanie drużyn i ich składu.
10. Rozgrywanie meczu między dwiema drużynami:
o Zwycięska drużyna dostaje +10 punktów do rankingu.
o Przegrana drużyna traci 5 punktów.
o Wynik meczu jest zapisywany w historii meczów.
11. Wyświetlanie historii meczów.
12. Ranking drużyn na podstawie liczby wygranych meczów.
13. Automatyczne generowanie turniejowej drabinki dla 4 lub 8 drużyn i symulacja wyników.
14. Wyszukiwanie gracza po nazwisku.
15. Wyjście z programu.
Dodatkowe wymagania:
 Program nie używa klas, jedynie tablic, list i słowników.
 Kod powinien mieć około 300 linii.
 Zaawansowane operacje na strukturach danych, takich jak listy i słowniki.
 Walidacja danych wejściowych użytkownika (np. sprawdzanie poprawności liczby graczy w 
drużynie)


System zarządzania drużynami sportowymi w C#
Napisz program w języku C#, który zarządza danymi sportowymi, wykorzystując tablice, listy, słowniki oraz typ
wyliczeniowy (enum). Program powinien zawierać menu tekstowe, umożliwiające użytkownikowi interakcję z
systemem. Nie używaj klas – cały kod ma opierać się na funkcjach i strukturach wbudowanych.
Wymagania funkcjonalne:
1. Utwórz enum DyscyplinaSportowa, który będzie przechowywał co najmniej 6 różnych dyscyplin
sportowych, np.:
o PilkaNozna
o Koszykowka
o Siatkowka
o Lekkoatletyka
o Tenis
o Hokej
2. Zadeklaruj tablicę przechowującą nazwy 10 drużyn sportowych (np. „Orły Warszawa”, „Smoki
Kraków”).
3. Utwórz listę zawodników, gdzie każdy zawodnik będzie reprezentowany przez krotkę:
(string imie, string nazwisko, DyscyplinaSportowa dyscyplina, int wiek, int
punkty).
o Lista powinna zawierać co najmniej 15 zawodników.
o Pole punkty reprezentuje sumę punktów zdobytych przez zawodnika.
4. Stwórz słownik, gdzie kluczem będzie nazwa drużyny, a wartością lista zawodników należących
do danej drużyny.
o Przypisz zawodników do drużyn w sposób losowy lub ręcznie.
Funkcje programu:
5. Wyświetlanie drużyny
o void WyswietlDruzyne(string nazwaDruzyny, Dictionary<string, List<(string,
string, DyscyplinaSportowa, int, int)>> druzyny)
o Wyświetla wszystkich zawodników danej drużyny wraz z ich dyscypliną, wiekiem oraz
zdobytymi punktami.
6. Dodawanie zawodnika do drużyny
o void DodajZawodnikaDoDruzyny(string druzyna, string imie, string nazwisko,
DyscyplinaSportowa dyscyplina, int wiek, Dictionary<string, List<(string,
string, DyscyplinaSportowa, int, int)>> druzyny)
o Umożliwia dodanie nowego zawodnika do istniejącej drużyny lub stworzenie nowej drużyny,
jeśli podana drużyna nie istnieje.
7. Usuwanie zawodnika
o void UsunZawodnika(string druzyna, string imie, string nazwisko,
Dictionary<string, List<(string, string, DyscyplinaSportowa, int, int)>>
druzyny)
o Usuwa zawodnika na podstawie jego imienia i nazwiska.
8. Wyświetlanie wszystkich zawodników danej dyscypliny
o void PokazZawodnikowDyscypliny(DyscyplinaSportowa dyscyplina, List<(string,
string, DyscyplinaSportowa, int, int)> zawodnicy)
o Wyświetla wszystkich zawodników uprawiających daną dyscyplinę.
9. Aktualizacja punktów zawodnika
o void AktualizujPunkty(string druzyna, string imie, string nazwisko, int
nowePunkty, Dictionary<string, List<(string, string, DyscyplinaSportowa,
int, int)>> druzyny)
o Pozwala dodać punkty do danego zawodnika.
10. Wyszukiwanie zawodnika po nazwisku
o void WyszukajZawodnika(string nazwisko, Dictionary<string, List<(string,
string, DyscyplinaSportowa, int, int)>> druzyny)
o Przeszukuje wszystkie drużyny i wyświetla informacje o zawodniku.
Interaktywne menu tekstowe:
11. Zaimplementuj w Main pętlę, która wyświetli użytkownikowi menu:
 Program powinien pobierać numer opcji od użytkownika i wywoływać odpowiednie funkcje.
 Obsłuż niepoprawne dane wejściowe (np. wprowadzenie tekstu zamiast liczby).
 Po zakończeniu operacji menu powinno się ponownie wyświetlić.
 Opcja "Zakończ program" powinna kończyć działanie pętli.
Dodatkowe utrudnienia:
✅ Dane muszą być przechowywane wyłącznie w tablicach, listach i słownikach – brak klas!
✅ Obsługa wyjątków – jeśli użytkownik wprowadzi błędne dane, program nie może się zawiesić.
✅ Kod ma być czytelny i dobrze sformatowany, z komentarzami opisującymi funkcje.
✅ Łączna liczba linii kodu w rozwiązaniu powinna wynosić około 250.
