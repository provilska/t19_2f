using System;
using System.Collections.Generic;

public enum GameGenre
{
    FPS,
    MOBA,
    BattleRoyale,
    RTS,
    RPG,
    Sportowe
}

public class Player
{
    public string FirstName { get; set; }
    public string LastName { get; set; }
    public int Age { get; set; }
    public string Team { get; set; } = null;
    public GameGenre Genre { get; set; }
    public int RankingPoints { get; set; }
}

public class Team
{
    public string Name { get; set; }
    public List<Player> Players { get; set; } = new List<Player>();
    public int TotalRankingPoints { get; set; }
    public int Wins { get; set; }
}

public class Match
{
    public string Team1 { get; set; }
    public string Team2 { get; set; }
    public string Winner { get; set; }
    public DateTime Date { get; set; }
}

public class Tournament
{
    private List<Player> players = new List<Player>();
    private List<Team> teams = new List<Team>();
    private List<Match> matchHistory = new List<Match>();

    public void AddPlayer()
    {
        Console.Write("Enter player's first name: ");
        string firstName = Console.ReadLine();
        Console.Write("Enter player's last name: ");
        string lastName = Console.ReadLine();
        Console.Write("Enter player's age: ");
        int age = int.Parse(Console.ReadLine());
        Console.WriteLine("Select game genre:");
        foreach (var genre in Enum.GetValues(typeof(GameGenre)))
        {
            Console.WriteLine($"{(int)genre}. {genre}");
        }
        GameGenre genre = (GameGenre)int.Parse(Console.ReadLine());

        players.Add(new Player { FirstName = firstName, LastName = lastName, Age = age, Genre = genre });
        Console.WriteLine("Player added successfully.");
    }

    public void CreateTeam()
    {
        Console.Write("Enter team name: ");
        string teamName = Console.ReadLine();

        Team team = new Team { Name = teamName };

        while (team.Players.Count < 5)
        {
            Console.WriteLine("Enter player to add to team:");
            Console.Write("Enter player's first name: ");
            string firstName = Console.ReadLine();
            Console.Write("Enter player's last name: ");
            string lastName = Console.ReadLine();

            Player player = players.Find(p => p.FirstName == firstName && p.LastName == lastName);
            if (player != null && player.Team == null)
            {
                team.Players.Add(player);
                player.Team = teamName;
            }
            else
            {
                Console.WriteLine("Player not found or already in a team.");
            }

            if (team.Players.Count == 5) break;
        }

        teams.Add(team);
        Console.WriteLine("Team created successfully.");
    }

    public void AssignPlayerToTeam()
    {
        Console.Write("Enter player's first name: ");
        string firstName = Console.ReadLine();
        Console.Write("Enter player's last name: ");
        string lastName = Console.ReadLine();

        Player player = players.Find(p => p.FirstName == firstName && p.LastName == lastName);
        if (player != null && player.Team == null)
        {
            Console.Write("Enter team name: ");
            string teamName = Console.ReadLine();

            Team team = teams.Find(t => t.Name == teamName);
            if (team != null && team.Players.Count < 5)
            {
                team.Players.Add(player);
                player.Team = teamName;
                Console.WriteLine("Player assigned to team.");
            }
            else
            {
                Console.WriteLine("Team not found or full.");
            }
        }
        else
        {
            Console.WriteLine("Player not found or already in a team.");
        }
    }

    public void RemovePlayerFromTeam()
    {
        Console.Write("Enter player's first name: ");
        string firstName = Console.ReadLine();
        Console.Write("Enter player's last name: ");
        string lastName = Console.ReadLine();

        Player player = players.Find(p => p.FirstName == firstName && p.LastName == lastName);
        if (player != null && player.Team != null)
        {
            Team team = teams.Find(t => t.Name == player.Team);
            if (team != null)
            {
                team.Players.Remove(player);
                player.Team = null;
                Console.WriteLine("Player removed from team.");
            }
        }
        else
        {
            Console.WriteLine("Player not found or not in any team.");
        }
    }

    public void PlayMatch()
    {
        Console.Write("Enter first team name: ");
        string team1Name = Console.ReadLine();
        Console.Write("Enter second team name: ");
        string team2Name = Console.ReadLine();

        Team team1 = teams.Find(t => t.Name == team1Name);
        Team team2 = teams.Find(t => t.Name == team2Name);

        if (team1 != null && team2 != null)
        {
            Random random = new Random();
            string winner = random.Next(2) == 0 ? team1.Name : team2.Name;

            if (winner == team1.Name)
            {
                team1.TotalRankingPoints += 10;
                team2.TotalRankingPoints -= 5;
                team1.Wins++;
            }
            else
            {
                team2.TotalRankingPoints += 10;
                team1.TotalRankingPoints -= 5;
                team2.Wins++;
            }

            matchHistory.Add(new Match
            {
                Team1 = team1Name,
                Team2 = team2Name,
                Winner = winner,
                Date = DateTime.Now
            });

            Console.WriteLine($"Match finished. Winner: {winner}");
        }
        else
        {
            Console.WriteLine("One or both teams not found.");
        }
    }

    public void ShowMatchHistory()
    {
        foreach (var match in matchHistory)
        {
            Console.WriteLine($"{match.Date}: {match.Team1} vs {match.Team2} - Winner: {match.Winner}");
        }
    }

    public void ShowRanking()
    {
        teams.Sort((t1, t2) => t2.Wins.CompareTo(t1.Wins));

        foreach (var team in teams)
        {
            Console.WriteLine($"{team.Name}: {team.Wins} wins");
        }
    }

    public void EditPlayerData()
    {
        Console.Write("Enter player's first name: ");
        string firstName = Console.ReadLine();
        Console.Write("Enter player's last name: ");
        string lastName = Console.ReadLine();

        Player player = players.Find(p => p.FirstName == firstName && p.LastName == lastName);
        if (player != null)
        {
            Console.Write("Enter new age: ");
            player.Age = int.Parse(Console.ReadLine());
            Console.Write("Enter new ranking points: ");
            player.RankingPoints = int.Parse(Console.ReadLine());
            Console.WriteLine("Player data updated.");
        }
        else
        {
            Console.WriteLine("Player not found.");
        }
    }

    public void ShowPlayersByGenre()
    {
        Console.WriteLine("Select game genre:");
        foreach (var genre in Enum.GetValues(typeof(GameGenre)))
        {
            Console.WriteLine($"{(int)genre}. {genre}");
        }

        GameGenre genreFilter = (GameGenre)int.Parse(Console.ReadLine());

        foreach (var player in players)
        {
            if (player.Genre == genreFilter)
            {
                Console.WriteLine($"{player.FirstName} {player.LastName}, Age: {player.Age}, Points: {player.RankingPoints}");
            }
        }
    }

    public void MainMenu()
    {
        while (true)
        {
            Console.WriteLine("\n--- Tournament Management ---");
            Console.WriteLine("1. Add player");
            Console.WriteLine("2. Create team");
            Console.WriteLine("3. Assign player to team");
            Console.WriteLine("4. Remove player from team");
            Console.WriteLine("5. Play match");
            Console.WriteLine("6. Show match history");
            Console.WriteLine("7. Show team rankings");
            Console.WriteLine("8. Edit player data");
            Console.WriteLine("9. Show players by genre");
            Console.WriteLine("10. Exit");
            Console.Write("Select an option: ");
            int option = int.Parse(Console.ReadLine());

            switch (option)
            {
                case 1: AddPlayer(); break;
                case 2: CreateTeam(); break;
                case 3: AssignPlayerToTeam(); break;
                case 4: RemovePlayerFromTeam(); break;
                case 5: PlayMatch(); break;
                case 6: ShowMatchHistory(); break;
                case 7: ShowRanking(); break;
                case 8: EditPlayerData(); break;
                case 9: ShowPlayersByGenre(); break;
                case 10: return;
                default: Console.WriteLine("Invalid option."); break;
            }
        }
    }

    static void Main(string[] args)
    {
        Tournament tournament = new Tournament();
        tournament.MainMenu();
    }
}
Twoim zadaniem jest napisanie programu konsolowego w C#, który będzie zarządzał turniejem esportowym. Program powinien obsługiwać graczy, drużyny oraz rozgrywki. Należy zaimplementować
menu, które umożliwi użytkownikowi wykonywanie różnych operacji na danych.
Zadanie zostało utrudnione poprzez dodanie nowych funkcjonalności:
 Historia meczów między drużynami.
 Ranking drużyn na podstawie liczby wygranych meczów.
 Automatyczne generowanie turniejowej drabinki i symulacja wyników.
 Drużyny mogą zostać rozwiązane, a ich gracze wracają do puli wolnych zawodników.
 Możliwość edycji danych graczy (np. zmiana drużyny, wieku itp.).
Wymagania funkcjonalne:
1. Definicja enum dla gatunków gier:
o FPS, MOBA, BattleRoyale, RTS, RPG, Sportowe.
2. Struktura danych dla graczy:
o Każdy gracz ma:
 imię
 nazwisko
 wiek
 drużynę (lub informację, że nie należy do żadnej)
 gatunek gry
 liczbę punktów rankingowych
3. Struktura danych dla drużyn:
o Drużyna posiada:
 nazwę
 listę graczy
 łączną liczbę punktów rankingowych
 liczbę wygranych meczów
o Drużyna może liczyć maksymalnie 5 graczy.
4. Struktura danych dla historii meczów:
o Każdy mecz zawiera:
 Nazwy drużyn, które ze sobą rywalizowały
 Zwycięzcę meczu
 Datę meczu
Funkcjonalność programu:
1. Wyświetlanie menu z dostępnymi opcjami.
2. Dodawanie nowego gracza do systemu.
3. Tworzenie nowej drużyny.
4. Przypisywanie gracza do drużyny (jeśli drużyna nie ma jeszcze 5 członków).
5. Usuwanie gracza z drużyny.
6. Rozwiązanie drużyny (wszyscy gracze wracają do puli wolnych zawodników).
7. Edycja danych gracza (zmiana drużyny, wieku, punktów rankingowych).
8. Przeglądanie graczy według gatunku gry.
9. Przeglądanie drużyn i ich składu.
10. Rozgrywanie meczu między dwiema drużynami:
o Zwycięska drużyna dostaje +10 punktów do rankingu.
o Przegrana drużyna traci 5 punktów.
o Wynik meczu jest zapisywany w historii meczów.
11. Wyświetlanie historii meczów.
12. Ranking drużyn na podstawie liczby wygranych meczów.
13. Automatyczne generowanie turniejowej drabinki dla 4 lub 8 drużyn i symulacja wyników.
14. Wyszukiwanie gracza po nazwisku.
15. Wyjście z programu.
Dodatkowe wymagania:
 Program nie używa klas, jedynie tablic, list i słowników.
 Kod powinien mieć około 300 linii.
 Zaawansowane operacje na strukturach danych, takich jak listy i słowniki.
 Walidacja danych wejściowych użytkownika (np. sprawdzanie poprawności liczby graczy w 
drużynie)


System zarządzania drużynami sportowymi w C#
Napisz program w języku C#, który zarządza danymi sportowymi, wykorzystując tablice, listy, słowniki oraz typ
wyliczeniowy (enum). Program powinien zawierać menu tekstowe, umożliwiające użytkownikowi interakcję z
systemem. Nie używaj klas – cały kod ma opierać się na funkcjach i strukturach wbudowanych.
Wymagania funkcjonalne:
1. Utwórz enum DyscyplinaSportowa, który będzie przechowywał co najmniej 6 różnych dyscyplin
sportowych, np.:
o PilkaNozna
o Koszykowka
o Siatkowka
o Lekkoatletyka
o Tenis
o Hokej
2. Zadeklaruj tablicę przechowującą nazwy 10 drużyn sportowych (np. „Orły Warszawa”, „Smoki
Kraków”).
3. Utwórz listę zawodników, gdzie każdy zawodnik będzie reprezentowany przez krotkę:
(string imie, string nazwisko, DyscyplinaSportowa dyscyplina, int wiek, int
punkty).
o Lista powinna zawierać co najmniej 15 zawodników.
o Pole punkty reprezentuje sumę punktów zdobytych przez zawodnika.
4. Stwórz słownik, gdzie kluczem będzie nazwa drużyny, a wartością lista zawodników należących
do danej drużyny.
o Przypisz zawodników do drużyn w sposób losowy lub ręcznie.
Funkcje programu:
5. Wyświetlanie drużyny
o void WyswietlDruzyne(string nazwaDruzyny, Dictionary<string, List<(string,
string, DyscyplinaSportowa, int, int)>> druzyny)
o Wyświetla wszystkich zawodników danej drużyny wraz z ich dyscypliną, wiekiem oraz
zdobytymi punktami.
6. Dodawanie zawodnika do drużyny
o void DodajZawodnikaDoDruzyny(string druzyna, string imie, string nazwisko,
DyscyplinaSportowa dyscyplina, int wiek, Dictionary<string, List<(string,
string, DyscyplinaSportowa, int, int)>> druzyny)
o Umożliwia dodanie nowego zawodnika do istniejącej drużyny lub stworzenie nowej drużyny,
jeśli podana drużyna nie istnieje.
7. Usuwanie zawodnika
o void UsunZawodnika(string druzyna, string imie, string nazwisko,
Dictionary<string, List<(string, string, DyscyplinaSportowa, int, int)>>
druzyny)
