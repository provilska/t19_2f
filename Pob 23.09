			Console.WriteLine(text2); //  Franciszek
			text2= text2.Trim();
			Console.WriteLine(text2.Lenght); //10
			
			string text3 = " Janusz  ";
			string trimmedStart = text3.TrimStart;
			string trimmedEnd = text3.TrimEnd;
			Console.WriteLine(text3.Lenght); //9
