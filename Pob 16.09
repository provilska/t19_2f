using System; 
using System.Collections.Generic; 
using System.Linq; 
using System.Text; 
using System.Threading.Tasks; 
 
namespace project_1_16_09_2024 
{ 
    internal class Program 
    { 
        static void Main(string[] args) 
        { 
            Console.Write("Programowanie"); 
            Console.WriteLine(" w języku C#"); 
            //komentarz jedna linia 
 
            /*w wielu 
             * liniach*/ 
 
            byte b = 0; //!! nie można -1 wytłumaczyć nie jest ten typ 
            //+ => konkatenacja 
            Console.WriteLine("Zmienna b wynosi: " +b); 
 
            byte sb = 0; //127 max 
            //nu tipa ważno 
            Console.WriteLine("Zmienna sb wynosi: " + sb); 
 
            short s = -2000; 
            ushort us = 1000; 
            //formatowanie czągów za pomocą metody Console.WriteLine(""); i indeksów miejsc w czągów, starszy sposób 
            Console.WriteLine("Zmienna s wynosi: {0}, zmienna us wynosi: {1}", s, us);//interpolacja 
            //nowszy sposób  - interpolacja  
            Console.WriteLine($"Zmienna s wynosi: {s}, zmienna us wynosi: {us}"); 
 
            Int16 i = 32767; //short 
            Int16 ii = -32767; //short max 32768 
 
            System.Int64 i2 = 999999999999999999; //wrode max 18 
 
            int i3 = 10; 
            Int32 i4 = 10; 
            System.Int32 i5 = 10; 
            Console.WriteLine("Rozmiar typu bool: " + sizeof(bool)); //1 bajt ?8 bitów? 
 
            float f = 10.5F; 
            Console.WriteLine(f); //10,5 
            Console.WriteLine("Rozmiar typu float: " + sizeof(float));//32bita 4bajt 
 
            long l = 10L; 
 
            Console.WriteLine("Rozmiar typu double: " + sizeof(double));//8 bajtów  
            Console.WriteLine("Rozmiar typu decimal: " + sizeof(double));//16 bajtów 
            Console.WriteLine("Rozmiar typu char: " + sizeof(char));//2 bajtów 
 
            decimal d = 10M; // m nie obowiązkowo 
            Console.WriteLine("Rozmiar typu decimal: " + sizeof(decimal));//16 bajtów 
 
            //System.Int128 = 10; nie występuje dotnet 8 
 
            string text; 
            text = d.ToString(); 
            Console.WriteLine(text);//nu tipa conwert 
 
            string text2 = 10.ToString(); 
 
            bool check = true; 
            Console.WriteLine(check);//true 
 
            check = false; 
            Console.WriteLine(check);//false 
 
            ushort us1 = 1; //nie można -1 
            uint ui = 1U; 
            ulong ul1 = 1UL; 
 
            //systemy liczbowe 
            //Console.WriteLine(8); 
            //Console.WriteLine(09);//oktalna 
 
 
            //decimalny dzisięyny  
            Console.WriteLine(11); 
 
            //binary dwójkowe 
            //prefix 0b 
            Console.WriteLine(0b101);//5 
 
            //oktalna ósemkowy 
            //brak natywnego wsparcia, możemy użyć konwersji z cąngu znaków 
            int osemkowa = Convert.ToInt32("42", 8); 
            Console.WriteLine(osemkowa);// dostaniemy 34 
 
            //cheksadycemalny szesnastkowa 
            // prefix 0x 
            int szesnastkowa = 0x2B; 
            Console.WriteLine(szesnastkowa);//43 
 
            //konwersja liczby dzięsięntnej na binarną 
            int liczba = 32; 
            string binarna = Convert.ToString(liczba, 2); 
            Console.WriteLine(binarna); //100001 
 
 
            Console.WriteLine(byte.MinValue); //0 
            Console.WriteLine(byte.MaxValue); //255 
 
            Console.WriteLine(sbyte.MinValue); //-128 
            Console.WriteLine(sbyte.MaxValue); //127 
 
            Console.WriteLine(int.MinValue); //-2147483648 
            Console.WriteLine(Int32.MaxValue); //2147483647 
 
            Console.WriteLine(long.MinValue); //0 
            Console.WriteLine(long.MaxValue); //255 
 
 
            Console.ReadKey(); 
        } 
    } 
}
