1 Operacje na katalogach i plikach
# Wyświetlenie bieżącego katalogu
3 pwd
# Zmiana katalogu (cd) i wklejanie adresu (shif
t + insert)
6 cd shift + insert
8 # Wyświetlenie plików w katalogu
9 1s
# Wyświetlenie ukrytych plików
ls -a
# Wyświetlenie szczegółowych informacji o plika ch (w tym ukrytych)
ls -la
# Tworzenie pliku README.md i zapisanie treści
echo "# pierwszy projekt" > README.md
# Tworzenie pliku "test" z zawartością "test"
echo "test" > test
# Wyświetlenie zawartości pliku .git
cat .git
# Tworzenie pustego pliku .git
touch.git
# Czyszczenie terminala
clear
# Tworzenie aliasu do czyszczenia ekranu
alias c=clear
git init
# Inicjalizacja nowego repozytorium Git
git init
# Wyświetlenie aktualnego stanu repozytorium
git status
# Klonowanie zdalnego repozytorium
git clone link_do_repo
# Dodanie pliku "test" do śledzenia
git add test
# Dodanie pliku README.md do śledzenia
git add README.md
# Tworzenie commitu z opisem "test"
git commit -m "test"
# Tworzenie commitu z opisem "dodanie pliku REA DME.md do repo"
git commit -m "dodanie pliku README.md do repo"
# Wysyłanie zmian na zdalne repozytorium (gałąź master)
git push u origin master
# Wysyłanie lokalnych commitów do zdalnego repo zytorium
git push

Operacje na plikach i konfiguracji Gita
# Wyświetlenie zawartości katalogu .git
ls .git
# Wyświetlenie zawartości katalogu info w folde rze .git
ls .git/info

