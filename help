# Inicjalizacja nowego repozytorium Git
git init
# Wyświetlenie aktualnego stanu repozytorium
git status
# Klonowanie zdalnego repozytorium
git clone link_do_repo
# Dodanie pliku "test" do śledzenia
git add test
# Dodanie pliku README.md do śledzenia
git add README.md
# Tworzenie commitu z opisem "test"
git commit -m "test"
# Tworzenie commitu z opisem "dodanie pliku REA DME.md do repo"
git commit -m "dodanie pliku README.md do repo"
# Wysyłanie zmian na zdalne repozytorium (gałąź master)
git push u origin master
# Wysyłanie lokalnych commitów do zdalnego repo zytorium
git push

Operacje na plikach i konfiguracji Gita
# Wyświetlenie zawartości katalogu .git
ls .git
# Wyświetlenie zawartości katalogu info w folde rze .git
ls .git/info

Tworzenie repo
1 mkdir git1
cd git1
3 git init
git add.
5 echo "# git1" >> README.md
6 git remote add orgin https://github.com/ GrygielSzymon/git1.git
git push orgin main
mkdir git1
cd git
$ echo "# git1" >> README.md
$ git init
$ git add README.md
$ git commit -m "first commit"
$ git branch -M main
8. $ git remote add origin https://github.com/ GrygielSzymon/git1.git
