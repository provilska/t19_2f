static int[,] CreateMultiArray()
{
    Console.WriteLine("Podaj ilość wierszy:");
    int rows = int.Parse(Console.ReadLine());
    Console.WriteLine("Podaj ilość kolumn:");
    int cols = int.Parse(Console.ReadLine());
    int[,] MultiArray = new int[rows,cols];
    Random r = new Random();
    for (int i = 0; i < MultiArray.GetLength(0); i++)
    {
        for (int j = 0; j < MultiArray.GetLength(1); j++)
        {
            MultiArray[rows,cols] = r.Next(1, 101);
        }
    }
    Console.WriteLine("Tablica została wypełniona losowymi wartościami");
    return MultiArray;
}
static void DisplayMultiArray(int [,]MultiArray)
{
    for(int i = 0; i < MultiArray.GetLength(0); i++)
    {
        for(int j = 0; j < MultiArray.GetLength(1); j++)
        {
            Console.Write($"{MultiArray[i,j]}   ");
        }
        Console.WriteLine();
    }
}


