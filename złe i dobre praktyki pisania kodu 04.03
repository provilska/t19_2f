//wejściowy kod
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace _1_bugs
{
    class Program
    {
        class Employee
        {
            public string Name;
            public int Age;
            public double Salary;

            public Employee(string name, int age, double salary)
            {
                Name = name;
                Age = age;
                Salary = salary;
            }
            public void IncreaseSalary(double amount)
            {
                Salary += amount;
            }
        }
        static void Main(string[] args)
        {
            Employee employee = new Employee("Sofia", 17, 0000);
            Console.WriteLine(employee.ToString());
        }
    }
}

//błędy
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace _1_bugs
{
    class Program
    {
        class Employee
        {
            //brak enkapsulacji, niepoprawne użycie pól zamiast własciwości(nie mamy kontroli nad ustawianiem wartości),
            //brak zabezpieczenia przed pustym imieniem
            public string Name;
            public int Age; //błędny typ danych, powiniśmy zastosowa: byte (0-255), ushort(0-),
                            //DateTime (musimy dodac metode obliczjącą wiek w czasie rzeczywistym)
            public double Salary;

            public Employee(string name, int age, double salary)
            {
                Name = name;
                Age = age;
                Salary = salary;
            }
            //brak walidacji w metodzie, nie sprawdzamy czy amount jest dodatni
            public void IncreaseSalary(double amount)
            {
                Salary += amount;
            }
        }
        static void Main(string[] args)
        {
            Employee employee = new Employee("Sofia", 17, 0);
            employee.Age = -5; //możemy ustawić błędny wiek
            employee.Salary = -1000; //możemy ustawic niegatywną pensje
            Console.WriteLine($"Imię: {employee.Name}, Wiek: {employee.Age}, Pensja: {employee.Salary}");
        }
    }
}

//fixed version
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Xml.Linq;

namespace _1_fixed_version
{
    class Program
    {
        class Employee
        {
            public string Name { get; }
            public DateTime DateOfBirth { get; }
            public int Age => CalculateAge();
            public Employee(string name, DateTime dateOfBirth)
            {
                Name = name;
                DateOfBirth = dateOfBirth;
            }

            private int CalculateAge()
            {
                var today = DateTime.Today;
                int age = today.Year - DateOfBirth.Year;
                if (DateOfBirth.Date > today.AddYears(-age))
                    age--;
                return age;
            }
        }
        static void Main(string[] args)
        {
            string name = GetValideName();
            DateTime dateOfBirth = GetValideDate();

            Employee employee = new Employee(name, dateOfBirth);
            Console.WriteLine($"Pracownik: {employee.Name}, Wiek: {employee.Age}");
        }

        private static DateTime GetValideDate()
        {
            DateTime dateOfBirth;
            bool isValidDate = false;
            do
            {
                Console.Write("Podaj date urodzenia (RRRR-MM-DD): ");
                string input = Console.ReadLine();

                if (DateTime.TryParse(input, out dateOfBirth) && dateOfBirth <= DateTime.Now)
                {
                    isValidDate = true;
                }
                else
                {
                    Console.WriteLine("Podaj poprawna date uroszenia (w przeszłości)");
                }
            }
            while (!isValidDate);
            return dateOfBirth;
            
        }

        private static string GetValideName()
        {
            string name;
            do
            {
                Console.Write("Podaj imię: ");
                name = Console.ReadLine()?.Trim();
                if (string.IsNullOrWhiteSpace(name))
                {
                    Console.WriteLine("Błąd: Imię nie może byz puste");
                }
            }
            while (string.IsNullOrWhiteSpace(name));
            return name;
        }
    }
}
