tylda
nie zwraca wartości
jest wyłowywany przy usuwaniu obiektu automatycznue
nie można przeciążać
alokacja, zabespieczenie pamięci, zwalnianie zasobów
destruktory są używane w klasaach z nie zarządzonymi zasobami 
 jest zależny od gabrig collector
inicjalizacja obiektu - wykonują kod sprzątający przed usunięcięm obiektu dispose

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace SofiaProvilska2f
{
        class FileHandler
        {
            private string fileName;
            public FileHandler(string fileName)
            {
                this.fileName = fileName;
                Console.WriteLine($"Plik o nazwie {fileName} został otwarty.");
            }
            //destruktor wywoływany automatycznie
            ~FileHandler()
            {
                Console.WriteLine($"Plik {fileName} został zamknięty.");
            }
        }
    class Program
    {
        static void UseFile()
        {
            //tworzymu obiekt klasy FileHandle
            FileHandler file = new FileHandler("document.txt");

        }
        static void Main(string[] args)
        {
            Console.WriteLine("Rozpoczęcie programu");

            //wywołujemy metodę która tworzy obiekt FileHandle
            Console.WriteLine("Wymuszenie czyśczenia pamięci.");

            //ręczne uruchomienie garbage collector
            GC.Collect();
            GC.WaitForPendingFinalizers();
            //GC.Collect() - wymusza uruchomienie garbage collectora, który przeszuka pamięć w poszukiwaniu nieużywanych obiektów
            // GC.WaitForPendingFinalizers() - czeka aż wszystkie destruktory FileHandle zostaną wykonane
        }
    }
}

using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace _10_destruktory
{
    class FileHandler : IDisposable
    {
        private string fileName;
        private string content;
        private bool disposed = false;
        //konstruktor-wywolywany przy tworzeniu obiektu
        public FileHandler(string fileName)
        {
            this.fileName = fileName;
            this.content = "zawartość pliku";
            Console.WriteLine($"Plik {fileName} został otwarty");
        }
        //dystruktor-wywoływany automatycznie przy usuwaniu obiektu
        ~FileHandler()
        {
            Console.WriteLine($"plik {fileName} został zamknięty");
        }
        public void Dispose()
        {
            Dispose(true);
            GC.SuppressFinalize(this);
        }
        protected virtual void Dispose(bool disposing)
        {
            if (!disposed)
            {
                if (disposing)
                {
                    Console.WriteLine($"Plik {fileName} został zamkniety.");
                }
                disposed = true;
            }
        }
        public void ShowContent()
        {
            Console.WriteLine($"zawartość pliku {fileName}: ");
        }
    }
    internal class Program
    {
        static void UseFile()
        {
            using (FileHandler fileHandler = new FileHandler("document.txt"))
            {
                fileHandler.ShowContent();
            }

            ////tworzymy obiekt klasy FileHandler
            //FileHandler file = new FileHandler("document.txt");
            //file.ShowContent();
            //System.Threading.Thread.Sleep(2000);
        }



        static void Main(string[] args)
        {
            Console.WriteLine("Rozpoczęcie programu");
            //wywolujemy metodę która tworzy obiekt FileHandler
            UseFile();
            Console.WriteLine("Wymuszenie czyśćenia pamięci");
            //ręczne uruchomienia garbage collectora

            GC.Collect();
            GC.WaitForPendingFinalizers();

            //GC.Collect() - wymusza uruchomienia garbage cotectora, który przeszuka pamięć w poszukiwaniu nieużywanych obiektów

            //GC.WaitForPendingFinalizers() - czeka aż wszystkie dystruktory (~FileHandler()) zostaną wykonane
            Console.WriteLine("Koniec programu");
            Console.ReadKey();
        }
    }
}
