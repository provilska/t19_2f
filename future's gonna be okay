        {
            string value;
            string[] ErrorMessage = new string[]
            {
                $"Pole {name} nie może byc puste",
                $"{name} musi mieć conajmniej {minLength} znaków",
                $"{name} nie może mieć powyżej {maxLength} znaków"
            };
            do
            {
                Console.WriteLine($"Podaj {name}");
                value = Console.ReadLine()?.Trim();
                Console.ForegroundColor = ConsoleColor.Red;
                if (string.IsNullOrWhiteSpace(value))
                {
                    Console.WriteLine(ErrorMessage[0]);
                }
                else if (value.Length < minLength)
                {
                    Console.WriteLine(ErrorMessage[1]);
                }
                else if (value.Length > maxLength)
                {
                    Console.WriteLine(ErrorMessage[2]);
                }
                Console.ResetColor();
            }
            while (string.IsNullOrWhiteSpace(value) || value.Length < minLength || value.Length > maxLength);
            return value;
        }

        private static void DisplayMenu()
        {
            Console.WriteLine("1.Dodaj książkę");
            Console.WriteLine("2.Wyświetl wszystkie książki");
            Console.WriteLine("3.Usuń książke po tytule");
