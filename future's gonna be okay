using System;

namespace car
{
    internal class Program
    {
        class Car
        {
            public string Mark { get; }
            public string Model { get; }
            public int Year { get; }
            public int Power { get; }

            //konstruktor domyślny
            public Car()
            {
                Mark = "Toyota";
                Model = "Corolla";
                Year = 1996;
                Power = 200;
            }
            //konstruktor parametryczny
            public Car(string mark, string model, int year, int power)
            {
                Mark = mark;
                Model = model;
                Year = year;
                Power = power;
            }

            public override string ToString()
            {
                return $"{Mark} {Model} ({Year}) - {Power} KM";
            }

        }
        static void Main(string[] args)
        {
            Car car1 = new Car("Toyota", "Corolla", 1996, 200);
            DisplayInfo(car1);
            string mark = GetValidString("markę");
            string model = GetValidString("model");
            int year = GetValidYear();
            int power = 0;
            Car car2 = new Car(mark, model, year, power);
            DisplayInfo(car2);
        }

        private static int GetValidYear()
        {
            int year;
            bool isValid = true;
            do
            {
                Console.WriteLine("Podaj rok produkcji samochodu");
                string input = Console.ReadLine();
                if (!int.TryParse(input, out year))
                {
                    isValid=false;
                    Console.WriteLine("Podaj poprawny format");
                }
                else if (year < 1886 || year > DateTime.Now.Year)
                {
                    isValid = false;
                    Console.WriteLine($"Rok produkcji nie może być mniejszy od 1886 roku i większy od {DateTime.Now.Year}");
                }
            }
            while (!isValid || year < 1886 || year > DateTime.Now.Year);
            return year;
        }

        const byte minLength = 3;
        const byte maxLength = 30;
        private static string GetValidString(string field)
        {
            string value;

            string[] ErrorMessage = new string[]
            {
                $"Pole {field} nie może byc puste",
                $"Pole {field} mieć conajmniej {minLength} znaków",
                $"Pole {field} nie może mieć powyżej {maxLength} znaków",
                "Wprowadzony tekst zawiera nieprawidłowe znaki."
            };
            do
            {
                Console.WriteLine($"Wpisz {field} samochodu: ");
                value = Console.ReadLine()?.Trim();
                if (string.IsNullOrWhiteSpace(value))
                {
                    Console.WriteLine(ErrorMessage[0]);
                }
                else if (value.Length < minLength)
                {
                    Console.WriteLine(ErrorMessage[1]);
                }
                else if (value.Length > maxLength)
                {
                    Console.WriteLine(ErrorMessage[2]);
                }
                else if (!value.All(char.IsLetter)) // Sprawdza, czy zawiera tylko litery
                {
                    Console.WriteLine(ErrorMessage[3]);
                }
            }
            while (string.IsNullOrWhiteSpace(value) || value.Length < minLength || value.Length > maxLength || !value.All(char.IsLetter));
            return value;
        }

        private static void DisplayInfo(Car car)
        {
            Console.WriteLine($"Informacje o samochodzie: Marka: {car.Mark}, Model: {car.Model}, Rok: {car.Year}, Moc: {car.Power} KM");
        }


    }
}

