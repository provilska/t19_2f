using System;

namespace employee
{
    internal class Program
    {
        class Employee
        {
            public string Name { get; }
            public string Position { get; }
            public decimal HourlyRate { get; }
            public decimal WorkedHours { get; }
            public decimal Salary => CalculateSalary();

            private decimal CalculateSalary()
            {
                return HourlyRate * WorkedHours;
            }

            public Employee()
            {
                Name = "yoonki";
                Position = "office kitten";
                HourlyRate = 7;
                WorkedHours = 77;
            }

            public Employee(string name, string position, decimal hourlyRate, decimal workedHours)
            {
                Name = name;
                Position = position;
                HourlyRate = hourlyRate;
                WorkedHours = workedHours;
            }
            public override string ToString()
            {
                return $"{Name} {Position} {Salary}";
            }
        }
        static void Main(string[] args)
        {
            Employee employee1 = new Employee("yoonki", "office kitten", 7, 77);
            DisplayInfo(employee1);

            string name = IsValidString("imię");
            string position = IsValidString("stanowisko");
            decimal hourlyRate = IsValidDecimal("stawka godzinowa");
            decimal workedHours = IsValidDecimal("liczba godzin miesięcznie");
            Employee employee2 = new Employee(name, position, hourlyRate, workedHours);
            DisplayInfo(employee2);
        }

        private static decimal IsValidDecimal(string field)
        {
            int value;
            bool isValid = true;
            do
            {
                Console.WriteLine($"Podaj {field}");
                string input = Console.ReadLine();
                if (!int.TryParse(input, out value))
                {
                    isValid = false;
                    Console.WriteLine("Podaj poprawny format");
                }
                else
                {
                    isValid = true;
                }
            }
            while (!isValid);
            return value;
        }

        private static string IsValidString(string field)
        {
            string input;
            while (true)
            {
                try
                {
                    Console.WriteLine($"Podaj {field} pracownika: ");
                    input = Console.ReadLine();
                    if (string.IsNullOrEmpty(input))
                    {
                        throw new ArgumentNullException();
                    }
                    else if (!input.All(char.IsLetter))
                    {
                        throw new ArgumentOutOfRangeException();
                    }
                    break;
                }

            catch (ArgumentNullException)
            {
                Console.WriteLine($"Pole {field} nie może być puste!");
            }
            catch (ArgumentOutOfRangeException)
            {
                Console.WriteLine($"Pole {field} musi być ciągiem znaków!");
            }
        }
        return input;
    }

        private static void DisplayInfo(Employee employee)
        {
            Console.WriteLine($"Pracownik: Imię: {employee.Name}, Stanowisko: {employee.Position}, Pensja: {employee.Salary}");
        }
    }
}
